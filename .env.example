# ==============================================================================
# TradeForge Environment Variables Template (.env.example)
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & Secrets (Generate strong random 64-char keys in production)
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY_32BYTES_BASE64=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Database (PostgreSQL + TimescaleDB)
POSTGRES_USER=tradeforge
POSTGRES_PASSWORD=tradeforge_dev_secret
POSTGRES_DB=tradeforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tradeforge:tradeforge_dev_secret@localhost:5432/tradeforge

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# API Gateway Service
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
PORT=3000

# Default Risk Guard Platform Limits
MAX_CAPITAL_ALLOCATION_PER_USER_INR=500000.0
MAX_DAILY_LOSS_LIMIT_INR=10000.0
MAX_PER_TRADE_LOSS_LIMIT_INR=2500.0
MAX_OPEN_POSITIONS=3
MANDATORY_SQUARE_OFF_TIME_IST=15:15:00
TRADING_CUTOFF_TIME_IST=15:00:00

# Broker Gateway Defaults
DEFAULT_BROKER=paper
ENABLE_LIVE_TRADING=false

# Optional Real Broker Configs (Leave blank for Paper mode)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANGEL_API_KEY=
